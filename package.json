{
  "name": "payroll-main-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --debug-prerender",
    "postbuild": "node scripts/copy-standalone-assets.js",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx --env-file=.env scripts/check-db-version.ts",
    "db:drop-all": "tsx --env-file=.env scripts/drop-all-tables.ts",
    "db:reset": "tsx --env-file=.env scripts/db-reset.ts",
    "db:seed": "tsx --env-file=.env scripts/seed-rbac.ts",
    "db:seed:admin": "tsx --env-file=.env scripts/seed-admin.ts",
    "db:seed:platform": "tsx --env-file=.env scripts/seed-platform-admin.ts",
    "db:seed:leaves": "tsx --env-file=.env scripts/seed-statutory-leaves.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:watch": "node --import tsx --watch --test tests/*.test.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "libphonenumber-js": "^1.13.10",
    "lucide-react": "^1.17.0",
    "nepali-date-library": "^1.1.14",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.31",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0"
  }
}
