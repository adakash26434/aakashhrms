# ---------------------------------------------------------------------------
# AakashHRMS — environment variables
# Copy this file to `.env` and fill in the real values for your environment.
# In cPanel, set these in the "Environment Variables" section of the Node app
# (Software > Setup Node.js App) instead of committing a real .env file.
# NEVER commit your real .env with production secrets to git.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# cPanel: create the database + user in "PostgreSQL Databases", then build the URL:
#   postgresql://DB_USER:DB_PASSWORD@127.0.0.1:5432/DB_NAME
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/payroll"

# Application environment. Use "production" on the live server.
NODE_ENV="production"

# Port the standalone server listens on. On cPanel/Passenger this is set
# automatically by Passenger; set it here only for local/manual runs.
PORT=3000

# NextAuth (Auth.js) secret used to sign session JWTs. At least 32 characters,
# never shared with the PLATFORM_* secrets (checked at server start).
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# Canonical public URL of the app. AUTH_URL is read by Auth.js v5;
# NEXTAUTH_URL is the legacy fallback (set both for compatibility).
AUTH_URL="https://your-domain.com"
NEXTAUTH_URL="https://your-domain.com"

# Legacy NextAuth secret (Auth.js v5 falls back to this if AUTH_SECRET is unset).
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Initial admin user created by `npm run db:seed:admin`.
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="change-this-strong-password"

# ---------------------------------------------------------------------------
# Multi-Tenant SaaS Platform Configuration
# ---------------------------------------------------------------------------
# SINGLE_TENANT_MODE: Set to "true" during local dev or single-tenant legacy deployment.
SINGLE_TENANT_MODE="true"
PLATFORM_DATABASE_URL="postgresql://user:password@127.0.0.1:5432/payroll_platform"
PLATFORM_SECRETS_KEY="32-byte-hex-string-for-aes-256-gcm-credential-encryption"

# Secret key for signing Super Admin platform session + impersonation JWTs.
# REQUIRED in production and must differ from AUTH_SECRET and
# PLATFORM_SECRETS_KEY (platform login is refused otherwise). Development
# falls back to another secret with a warning.
# Generate one with:  openssl rand -base64 48
PLATFORM_SESSION_SECRET=""

# Default initial password for provisioned company admins (forced change on first login).
# If unset, a cryptographically secure random password is generated per company.
DEFAULT_TENANT_ADMIN_PASSWORD=""

ROOT_DOMAIN="localhost:3000"


# ---- Security (Phase 0) ----
# Number of reverse proxies in front of the app that APPEND to X-Forwarded-For.
# Yeti Cloud load balancer = 1 (app.js does not append). cPanel Apache/Passenger = 1.
# Behind Cloudflare too = 2. Exposed directly = 0.
# Used to read the real client IP for login rate limiting (spoofed values ignored).
TRUSTED_PROXY_HOPS="1"
